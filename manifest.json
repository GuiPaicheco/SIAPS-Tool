{
  "manifest_version": 3,
  "name": "SIAPS Tool",
  "version": "1.0.0",
  "description": "Geração de relatórios SIAPS para a DAPS Betim/MG.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://siaps.saude.gov.br/*"],
  "action": {
    "default_title": "SIAPS Tool",
    "default_popup": "popup.html",
    "default_icon": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" }
  },
  "icons": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://siaps.saude.gov.br/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
